# USB PHY TUSB1106 Pin Constraints (Bank WB)
# Reales Routing auf dem MillerV1-Board (vormals VGA-Pins):
Pin_out "usb_softcon" Loc = "IO_WB_A5";  # SOFTCON (Pin 2)  - ehem. VGA_Green_1 (Ball K1)
Pin_out "usb_oe_n"    Loc = "IO_WB_B4";  # ~OE     (Pin 3)  - ehem. VGA_Green_2 (Ball K4)
Pin_in  "usb_rcv"     Loc = "IO_WB_A4";  # RCV     (Pin 4)  - ehem. VGA_Green_3 (Ball K3)
Pin_in  "usb_vp"      Loc = "IO_WB_A6";  # VP      (Pin 5)  - ehem. VGA_Blue_3  (Ball J3)
Pin_in  "usb_vm"      Loc = "IO_WB_B6";  # VM      (Pin 6)  - ehem. VGA_Blue_2  (Ball J4)
Pin_out "usb_susp"    Loc = "IO_WB_A7";  # SUSPND  (Pin 7)  - ehem. VGA_Blue_1  (Ball H1)
Pin_out "usb_speed"   Loc = "IO_WB_A2";  # SPEED   (Pin 10) - ehem. VGA_Red_3   (Ball L3)
Pin_out "usb_vpo"     Loc = "IO_WB_B2";  # VPO     (Pin 13) - ehem. VGA_Red_2   (Ball L4)
Pin_out "usb_vmo"     Loc = "IO_WB_A3";  # VMO     (Pin 14) - ehem. VGA_Red_1   (Ball L1)

# clk48, rst und btn benoetigen noch Pins je nach Board-Variante;

