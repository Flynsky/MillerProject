# cc-pll.ccf 15.2.24/16.2.24 2nd & 3rd ver PDR
Pin_in "CLK0" Loc = "IO_SB_A8" | SCHMITT_TRIGGER=true;  #10MHz osc
Pin_out "locked" Loc = "IO_EB_A0";  #CCEVB J2 pin 33, Oli BANK_EB1 pin 19

Pin_out "CCEVB_LED" Loc = "IO_EB_B1";  #Oli BANK_EB1 pin 18
Pin_out "OLIMEX_LED" Loc = "IO_SB_B6";  #CCEVB J10 pin 18

# USB-PHY connections for 2nd USB-C port to FPGA pins (Bank WB)
Pin_out "usb_softcon" Loc = "IO_WB_A5"; # SOFTCON (Pin 2)
Pin_out "usb_oe_n"    Loc = "IO_WB_B4"; # ~OE     (Pin 3)
Pin_in  "usb_rcv"     Loc = "IO_WB_A4"; # RCV     (Pin 4)
Pin_in  "usb_vp"      Loc = "IO_WB_A6"; # VP      (Pin 5)
Pin_in  "usb_vm"      Loc = "IO_WB_B6"; # VM      (Pin 6)
Pin_out "usb_susp"    Loc = "IO_WB_A7"; # SUSPND  (Pin 7)
Pin_out "usb_speed"   Loc = "IO_WB_A2"; # SPEED   (Pin 10)
Pin_out "usb_vpo"     Loc = "IO_WB_B2"; # VPO     (Pin 13)
Pin_out "usb_vmo"     Loc = "IO_WB_A3"; # VMO     (Pin 14)